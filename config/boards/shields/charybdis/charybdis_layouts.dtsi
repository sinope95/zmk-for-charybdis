/* charybdis_mk2-layouts.dtsi
 * Physical layout for ZMK Studio support (template).
 * - Include this file from your board/shield overlay AFTER your kscan/transform nodes.
 * - Ensure your overlay defines &default_transform and &kscan0 (or adjust labels here).
 */

#include <physical_layouts.dtsi>

/ {
    charybdis_mk2_layout: physical_layout {
        compatible = "zmk,physical-layout";
        display-name = "Charybdis MK2 Default Layout";

        /* Link to your transform and kscan nodes (defined in your shield overlay) */
        transform = <&default_transform>;
        kscan = <&kscan0>;

        /* keys: <w h x y rot rx ry>
         * Units: w/h/x/y in hundredths of a key-unit (1u = 100). rot in degrees.
         * Template: 3x5+3 per side split (36 keys). Adjust to your exact shield.
         */

        keys =
            /* ---------- LEFT HALF ---------- */
            /* Row 0 (top) */
            <&key_physical_attrs 100 100    0    0   0  0 0>  /* L00 */
          , <&key_physical_attrs 100 100  100    0   0  0 0>  /* L01 */
          , <&key_physical_attrs 100 100  200    0   0  0 0>  /* L02 */
          , <&key_physical_attrs 100 100  300    0   0  0 0>  /* L03 */
          , <&key_physical_attrs 100 100  400    0   0  0 0>  /* L04 */

            /* Row 1 (home row) */
          , <&key_physical_attrs 100 100   10  100   0  0 0>  /* L10 */
          , <&key_physical_attrs 100 100  110  100   0  0 0>  /* L11 */
          , <&key_physical_attrs 100 100  210  100   0  0 0>  /* L12 */
          , <&key_physical_attrs 100 100  310  100   0  0 0>  /* L13 */
          , <&key_physical_attrs 100 100  410  100   0  0 0>  /* L14 */

            /* Row 2 (bottom row) */
          , <&key_physical_attrs 100 100   20  200   0  0 0>  /* L20 */
          , <&key_physical_attrs 100 100  120  200   0  0 0>  /* L21 */
          , <&key_physical_attrs 100 100  220  200   0  0 0>  /* L22 */
          , <&key_physical_attrs 100 100  320  200   0  0 0>  /* L23 */
          , <&key_physical_attrs 100 100  420  200   0  0 0>  /* L24 */

            /* Thumb cluster (3 keys) */
          , <&key_physical_attrs 100 100  260  310   -10  260 310> /* LT0 */
          , <&key_physical_attrs 100 100  350  330   -10  350 330> /* LT1 */
          , <&key_physical_attrs 100 100  440  350   -10  440 350> /* LT2 */

            /* ---------- RIGHT HALF ---------- */
            /* Row 0 (top) */
          , <&key_physical_attrs 100 100  800    0    0  0 0>  /* R00 */
          , <&key_physical_attrs 100 100  900    0    0  0 0>  /* R01 */
          , <&key_physical_attrs 100 100 1000    0    0  0 0>  /* R02 */
          , <&key_physical_attrs 100 100 1100    0    0  0 0>  /* R03 */
          , <&key_physical_attrs 100 100 1200    0    0  0 0>  /* R04 */

            /* Row 1 (home row) */
          , <&key_physical_attrs 100 100  810  100    0  0 0>  /* R10 */
          , <&key_physical_attrs 100 100  910  100    0  0 0>  /* R11 */
          , <&key_physical_attrs 100 100 1010  100    0  0 0>  /* R12 */
          , <&key_physical_attrs 100 100 1110  100    0  0 0>  /* R13 */
          , <&key_physical_attrs 100 100 1210  100    0  0 0>  /* R14 */

            /* Row 2 (bottom row) */
          , <&key_physical_attrs 100 100  820  200    0  0 0>  /* R20 */
          , <&key_physical_attrs 100 100  920  200    0  0 0>  /* R21 */
          , <&key_physical_attrs 100 100 1020  200    0  0 0>  /* R22 */
          , <&key_physical_attrs 100 100 1120  200    0  0 0>  /* R23 */
          , <&key_physical_attrs 100 100 1220  200    0  0 0>  /* R24 */

            /* Thumb cluster (3 keys) */
          , <&key_physical_attrs 100 100  980  310    10  980 310> /* RT0 */
          , <&key_physical_attrs 100 100 1070  330    10 1070 330> /* RT1 */
          , <&key_physical_attrs 100 100 1160  350    10 1160 350> /* RT2 */
        ;
    };
};