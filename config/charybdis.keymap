#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// 기본 이동 속도 (기본값: 600)
// 듀얼 모니터: 화면 전체를 빠르게 이동하려면 높게 설정

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000

// 스크롤 속도 (기본값: 10)

#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

// ========================================
// 마우스 이동 가속도 설정
// ========================================

&mmv {
    // 가속도 지수 (기본: 1)
    // 0 = 일정 속도, 1 = 선형, 2 = 제곱 가속
    // 듀얼 모니터: 1~2 권장 (빠른 이동 + 정밀 제어)

    acceleration-exponent = <1>;

    // 최대 속도 도달 시간 (기본: 300ms)
    // 짧을수록 빨리 가속됨
    // 듀얼 모니터: 200~400ms 권장

    time-to-max-speed-ms = <300>;

    // 초기 지연 (기본: 0ms)

    delay-ms = <0>;
    trigger-period-ms = <12>;
};

// ========================================
// 스크롤 설정
// ========================================

&msc {
    // 스크롤은 가속 없이 일정하게

    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

/ {
    // 세로 스크롤 인코더

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <100>;
    };

    // 가로 스크롤 인코더

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        // === 기본 홈로우 모드 (중지, 약지용) ===
        /*
            monkeytype.com에서 테스트:
            - 60 WPM 미만: tapping-term-ms = 250
            - 60-80 WPM: tapping-term-ms = 280
            - 80-100 WPM: tapping-term-ms = 300
            - 100+ WPM: tapping-term-ms = 320
        */

        hm: homerow_modes {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODES";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>; // 홀드/탭 판정 시간
            quick-tap-ms = <250>; // 같은 키 연타 시 탭으로 인식하는 최대 시간,  빠른 타이핑 보호
            require-prior-idle-ms = <200>; // 이전 입력 후 유휴 시간이 이보다 길어야 탭 인정, 빠른 타이핑 보호
            /* balanced flavor를 사용해야 hold-trigger-on-release가 제대로 작동함 */

            flavor = "balanced"; // 다른 키 누르기 전까지 탭
            retro-tap; // 혼자 길게 눌렀다 떼면 탭
            hold-while-undecided; // 키를 뗄 때 홀드 판정
        };

        // === 검지, 새끼 손가락용 (조금 더 관대) ===

        hm_outer: homerow_outer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_OUTER";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <230>;
            require-prior-idle-ms = <180>;
            flavor = "balanced"; // 다른 키 누르기 전까지 탭
            retro-tap; // 혼자 길게 눌렀다 떼면 탭
            hold-while-undecided; // 키를 뗄 때 홀드 판정
        };

        // === 왼손 홈로우 전용(반대편만 트리거) ===

        hm_left: homerow_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap; // 키를 혼자 길게 누르고 뗐을 때 탭으로 인식
            //hold-while-undecided; // 판정이 안 끝났을 때도 홀드 키를 누른 상태로 유지
            // 오른손 키 위치만 지정 (왼손 홈로우용)

            hold-trigger-key-positions = <
                6 7 8 9 10 11          // 오른손 숫자행
                18 19 20 21 22 23      // 오른손 상단행
                30 31 32 33 34 35      // 오른손 중간행
                42 43 44 45 46 47      // 오른손 하단행
                51 52 53 54 55         // 엄지
            >;

            hold-trigger-on-release;
        };

        // === 오른손 홈로우 전용(반대편만 트리거) ===

        hm_right: homerow_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            retro-tap; // 키를 혼자 길게 누르고 뗐을 때 탭으로 인식
            //hold-while-undecided; // 판정이 안 끝났을 때도 홀드 키를 누른 상태로 유지
            // 왼손 키 위치만 지정 (오른손 홈로우용)

            hold-trigger-key-positions = <
                0 1 2 3 4 5            // 왼손 숫자행
                12 13 14 15 16 17      // 왼손 상단행
                24 25 26 27 28 29      // 왼손 중간행
                36 37 38 39 40 41      // 왼손 하단행
                48 49 50               // 엄지
            >;

            hold-trigger-on-release;
        };

        // === Vim 방향키용 특수 설정 (J, K, L) ===

        hm_vim: homerow_vim {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_VIM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";

            // Vim 방향키 전용 설정

            tapping-term-ms = <280>;
            quick-tap-ms = <280>;                // 0으로! 연타 시 계속 반복
            require-prior-idle-ms = <150>;
            retro-tap;                         // 길게 누르면 반복 입력
            hold-trigger-key-positions = <
                0 1 2 3 4 5            // 왼손 숫자행
                12 13 14 15 16 17      // 왼손 상단행
                24 25 26 27 28 29      // 왼손 중간행
                36 37 38 39 40 41      // 왼손 하단행
                48 49 50               // 엄지
            >;

            hold-trigger-on-release;
        };

        //한영전환

        td_cmd: cmd_to_caps_ime {
            compatible = "zmk,behavior-tap-dance";
            label = "CMD_TO_CAPS";
            #binding-cells = <0>;
            tapping-term-ms = <230>;
            bindings = <&kp LGUI>, <&kp CAPS>;

            // 1회: CMD, 2회: Caps Lock
        };

        td_num_9: td_num_9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_9";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N9>, <&kp MINUS>;
        };

        td_num_0: td_num_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_0";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N0>, <&kp EQUAL>;
        };

        td_num_1: td_num_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_NUM_1";
            #binding-cells = <0>;
            tapping-term-ms = <230>;
            bindings = <&kp N1>, <&kp GRAVE>;
        };

        td_key_o: td_key_o {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_KEY_O";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&kp LBKT>;
        };

        td_key_p: td_key_p {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_KEY_P";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp P>, <&kp RBKT>;
        };

        td_key_enter: td_key_enter {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_KEY_ENTER";
            #binding-cells = <0>;
            tapping-term-ms = <230>;
            bindings = <&kp ENTER>, <&kp SQT>;
        };

        th_mkp_mo: th_mkp_mo {
            compatible = "zmk,behavior-hold-tap";
            label = "TH_MKP_MO";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC    &td_num_1         &kp N2           &kp N3           &kp N4             &kp N5           &kp N6        &kp N7            &kp N8          &td_num_9       &td_num_0                  &kp BACKSPACE
&kp TAB    &kp Q             &kp W            &kp E            &kp R              &kp T            &kp Y         &kp U             &kp I           &td_key_o       &td_key_p                  &kp BSLH
&kp LGUI   &hm_left LCTRL A  &hm_left LALT S  &hm_left LGUI D  &hm_left LSHIFT F  &kp G            &kp H         &hm_vim RSHIFT J  &hm_vim RGUI K  &hm_vim RALT L  &hm_right RCTRL SEMICOLON  &td_key_enter
&kp LSHFT  &kp Z             &kp X            &kp C            &kp V              &kp B            &kp N         &kp M             &kp COMMA       &kp DOT         &kp SLASH                  &kp RSHFT
                                              &lt 3 LCTRL      &lt 1 LALT         &lt 2 LA(TAB)    &lt 1 DELETE  &kp SPACE
                                                               &mkp MB1           &mkp MB2         &mo 1
            >;

            sensor-bindings =
                // 인코더1: 위아래 스크롤,,,,,,,,,,
                <&scroll_vertical_encoder>,
                // 인코더2: 좌우 스크롤,,,,,,,,,,
                <&scroll_horizontal_encoder>;
        };

        FUNC {
            bindings = <
&kp ESCAPE      &kp F1      &kp F2      &kp F3      &kp F4        &kp F5            &kp F6          &kp F7          &kp F8        &kp F9     &kp F10  &kp F11
&kp CAPS        &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &none         &studio_unlock    &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END    &none    &kp F12
&kp LGUI        &none       &none       &none       &none         &none             &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none    &none
&kp LEFT_SHIFT  &none       &none       &none       &none         &none             &none           &none           &none         &none      &none    &none
                                        &kp LCTRL   &kp LEFT_ALT  &none             &kp DELETE      &kp SPACE
                                                    &mkp MB1      &mkp MB2          &kp ENTER
            >;
        };

        NUM {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans  &trans    &trans     &trans        &kp SLASH     &kp ASTERISK  &kp MINUS   &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS    &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PERIOD  &trans
&trans      &trans  &trans  &trans  &trans  &trans    &trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER   &trans
                            &trans  &trans  &none     &kp SPACE  &kp NUMBER_0
                                    &trans  &trans    &kp ENTER
            >;
        };

        SNIPE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &trans    &trans    &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        /* layer_2 {
            bindings = <
&none  &none   &none    &none   &none         &none         &kp N1         &none         &none     &none  &none   &to 0
&none  &none   &none    &none   &none         &none         &none         &none          &rgb_ug RGB_BRD &rgb_ug RGB_BRI  &rgb_ug RGB_EFF   &rgb_ug RGB_TOG
&none  &none   &none    &none   &none         &none         &none         &mkp LCLK     &mkp RCLK  &none  &none   &none
&none  &none   &none    &none   &bt BT_NXT  &bt BT_CLR    &none         &none         &none     &none  &none   &none
                                   &none         &none         &none         &none         &none
                                                 &none         &none         &none
            >;
       
            
        };

       Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &trans        &trans        &mkp MCLK     &trans     &none         &none       &trans     &mkp MCLK     &trans        &trans        &none
&bootloader  &trans        &mkp RCLK     &mo 4         &mkp LCLK  &mo 5         &mo 5       &mkp LCLK  &mo 4         &mkp RCLK     &trans        &bootloader
                                         &mo 5         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &trans        &trans
            >;

            
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
               
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &trans  &trans     &mkp MCLK  &trans     &trans       &trans     &trans     &mkp MCLK  &trans     &trans  &trans
&trans  &trans  &mkp RCLK  &trans     &mkp LCLK  &trans       &trans     &mkp LCLK  &trans     &mkp RCLK  &trans  &trans
                           &trans     &mkp LCLK  &mkp RCLK    &mkp RCLK  &mkp LCLK
                                      &trans     &trans       &trans
            >;
                
                
        };*/
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
